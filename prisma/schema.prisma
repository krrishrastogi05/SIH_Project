generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // This is correct for Prisma v5
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String
  role      Role     @default(BENEFICIARY)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Name this relation "UserVerifications" to resolve the ambiguity
  beneficiaryVerifications BeneficiaryVerification[] @relation("UserVerifications")
  enumeratorVerifications  BeneficiaryVerification[] @relation("Enumerator")
  notifications            Notification[]

  // You likely have an old field here named "Verifications". DELETE IT.
  // Verifications BeneficiaryVerification[] // <-- DELETE THIS LINE
  SchemeFeed SchemeFeed[]
}

model SchemePoster {
  id        String   @id @default(uuid())
  name      String
  type      String
  phone     String
  email     String?
  state     String?
  district  String?
  block     String?
  createdAt DateTime @default(now())

  schemes SchemePost[]
}

model SchemePost {
  id             String       @id @default(uuid())
  posterId       String
  title          String
  description    String
  incomeRequired Boolean      @default(false)
  minIncome      Int?
  maxIncome      Int?
  regionType     String?
  state          String?
  district       String?
  block          String?
  jobType        String?
  paymentInfo    Json?
  additionalDocs Json?
  status         SchemeStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  poster        SchemePoster              @relation(fields: [posterId], references: [id])
  feeds         SchemeFeed[]
  verifications BeneficiaryVerification[]
}

model SchemeFeed {
  id               String     @id @default(uuid())
  schemeId         String
  userId           String
  eligibilityScore Int
  status           FeedStatus @default(NOTIFIED)

  scheme SchemePost @relation(fields: [schemeId], references: [id])
  user   User       @relation(fields: [userId], references: [id])
}

model BeneficiaryVerification {
  id           String   @id @default(cuid())
  status       String   @default("PENDING")
  feedback     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  enumeratorId String?

  // Add the same name "UserVerifications" here
  user         User        @relation("UserVerifications", fields: [userId], references: [id])
  enumerator   User?       @relation("Enumerator", fields: [enumeratorId], references: [id])
  SchemePost   SchemePost? @relation(fields: [schemePostId], references: [id])
  schemePostId String?
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  BENEFICIARY
  ENUMERATOR
  OFFICER
  POSTER
  ADMIN
}

enum SchemeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedStatus {
  NOTIFIED
  INTERESTED
  APPLIED
}

enum VerificationStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
}
