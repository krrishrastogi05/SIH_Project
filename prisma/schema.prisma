generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// USER MODEL
//////////////////////////////////////
model User {
  id       String  @id @default(uuid())
  scId     String  @unique // Beneficiary SC ID
  name     String
  email    String? @unique // Optional for beneficiaries
  phone    String? @unique // For login
  password String
  role     Role    @default(BENEFICIARY)

  // KYC Fields
  aadhaar      String? @unique
  casteCert    String?
  incomeCert   String?
  profileImage String?

  // Socio-Economic
  income    Int?
  age       Int?
  gender    String?
  education EducationLevel?
  skill     SkillLevel?

  // Address
  state    String?
  district String?
  block    String?
  pincode  String?

  // Bank Details
  bankAccount String?
  ifsc        String?

  // Verification
  verificationStatus  VerificationStatus @default(PENDING)
  verificationRemarks String?
  documents           String[] // Array of URLs

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  schemeFeeds              SchemeFeed[]
  beneficiaryVerifications BeneficiaryVerification[] @relation("UserVerifications")
  enumeratorVerifications  BeneficiaryVerification[] @relation("Enumerator")
  notifications            Notification[]

  paymentResolutionProofs  PaymentResolutionProof[] @relation("ProofOwner")
  reviewedResolutionProofs PaymentResolutionProof[] @relation("ProofReviewer")



  
  eligibleForSchemes  BeneficiaryScheme[] @relation("EligibleBeneficiaries")
}

//////////////////////////////////////
// SCHEME MODEL
//////////////////////////////////////
model Scheme {
  id           String   @id @default(cuid())
  schemeId     String   @unique // e.g., SCH-EDU-001
  title        String
  schemeType   String // "education", "housing", "employment", "financial"
  baseCriteria Json // Store base criteria object
  extraFields  Json // Store extra fields config
  state        String
  district     String
  pincode      String
  status       SchemeStatus @default(PENDING)

  
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  eligibleUsers  BeneficiaryScheme[] @relation("EligibleSchemes")

  // Relations
  feeds         SchemeFeed[]
  verifications BeneficiaryVerification[]

 
  // Optional: Add indexes for location fields if you query them often
  @@index([state, district])
}

//////////////////////////////////////
// SCHEME FEED
//////////////////////////////////////
model SchemeFeed {
  id               String           @id @default(uuid())
  schemeId         String
  userId           String
  eligibilityScore Int?
  status           SchemeFeedStatus @default(NOTIFIED)
  appliedDocs      Json?
  createdAt        DateTime         @default(now())

  scheme Scheme @relation(fields: [schemeId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  paymentTransactions PaymentTransaction[]

  @@unique([userId, schemeId])
}

//////////////////////////////////////
// BENEFICIARY VERIFICATION
//////////////////////////////////////
model BeneficiaryVerification {
  id           String             @id @default(uuid())
  userId       String
  enumeratorId String?
  schemeId     String?
  status       VerificationStatus @default(UNDER_REVIEW)
  remarks      String?
  documents    Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user       User    @relation("UserVerifications", fields: [userId], references: [id])
  enumerator User?   @relation("Enumerator", fields: [enumeratorId], references: [id])
  scheme     Scheme? @relation(fields: [schemeId], references: [id])
}

//////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////
model Notification {
  id        String    @id @default(uuid())
  userId    String
  message   String
  read      Boolean   @default(false)
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

//////////////////////////////////////
// CSV LOG
//////////////////////////////////////
model CsvLog {
  id        String   @id @default(cuid())
  fileName  String
  status    String // e.g., 'PENDING', 'PROCESSING', 'COMPLETED', 'FAILED'
  rowCount  Int
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentErrorCode {
  id              String               @id @default(cuid())
  code            String               @unique // e.g. "CPE0025"
  title           String // Short title: "Invalid Beneficiary Details"
  technicalReason String // System-side reason / PFMS text
  userMessage     String // Simple explanation for beneficiary
  resolutionSteps String // How to resolve (plain text, bullet points, etc.)
  resolver        PaymentErrorResolver // Who is expected to fix this

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  schemeFeedId    String
  errorCodeId     String?
  transactionRef  String?       @unique // Simulated UTR / txn ID
  amount          Int? // If you want to show amount, else optional
  status          PaymentStatus @default(PENDING)
  rawErrorMessage String? // If you want to store original PFMS-like message
  simulated       Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  schemeFeed       SchemeFeed               @relation(fields: [schemeFeedId], references: [id])
  errorCode        PaymentErrorCode?        @relation(fields: [errorCodeId], references: [id])
  resolutionProofs PaymentResolutionProof[]

  @@index([schemeFeedId])
}

model PaymentResolutionProof {
  id                   String           @id @default(uuid())
  paymentTransactionId String
  userId               String // Beneficiary who submitted proof
  description          String? // "I have now linked my Aadhaar with bank"
  proofUrls            String[] // Uploaded file URLs (Cloudinary/S3/etc.)
  status               ResolutionStatus @default(SUBMITTED)

  reviewerId      String? // Officer who reviews the proof
  reviewerRemarks String? // "Verified with bank statement", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])
  user               User               @relation("ProofOwner", fields: [userId], references: [id])
  reviewer           User?              @relation("ProofReviewer", fields: [reviewerId], references: [id])

  @@index([paymentTransactionId])
  @@index([userId])
  @@index([reviewerId])
}

//////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  role      String
  action    String
  target    String
  timestamp DateTime @default(now())
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////
enum Role {
  BENEFICIARY
  ENUMERATOR
  OFFICER
  ADMIN
  POSTER
}

enum SchemeStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum EducationLevel {
  MATRICULATION
  HIGHER_SECONDARY
  GRADUATION
  POST_GRADUATION
  DIPLOMA
  PHD
}

enum SkillLevel {
  NONE
  BASIC_COMPUTER
  TENTH_PASS
  TWELFTH_PASS
  ITI
  POLYTECHNIC
  GRADUATE
}

enum SchemeFeedStatus {
  NOTIFIED
  APPLIED
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING // Created but not processed
  PROCESSING // Simulating payment in progress
  SUCCESS // Payment completed
  FAILED // Payment failed with some error
}

enum PaymentErrorResolver {
  BENEFICIARY // Beneficiary has to fix (e.g. Aadhaar not linked)
  OFFICER // Officer/department has to fix (e.g. sanction issue)
  BANK // Bank-side issue
  SYSTEM // PFMS/NPCI/system issue
}

enum ResolutionStatus {
  SUBMITTED // Beneficiary uploaded proof
  UNDER_REVIEW // Officer is checking
  ACCEPTED // Officer accepted proof, can retry payment
  REJECTED // Proof not sufficient, ask again
}



model BeneficiaryScheme {
  id              String                @id @default(cuid())
  beneficiaryId   String
  schemeId        String
  beneficiary     User                  @relation("EligibleBeneficiaries", fields: [beneficiaryId], references: [id])
  scheme          Scheme                @relation("EligibleSchemes", fields: [schemeId], references: [id])
  status          ApplicationStatus     @default(ELIGIBLE)
  applicationData Json? // To store user's application for extraFields
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([beneficiaryId, schemeId]) // A user can only be linked to a scheme once
  @@index([beneficiaryId])
  @@index([schemeId])
}

// New Enum for application status
enum ApplicationStatus {
  ELIGIBLE    // Found by the system, can apply
  APPLIED     // User has submitted the application
  APPROVED    // Officer has approved the application
  REJECTED    // Officer has rejected the application
}