// This is your main Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// USER MODEL
//////////////////////////////////////
model User {
  id       String  @id @default(uuid())
  scId     String? @unique // Beneficiary SC ID / Officer ID
  name     String
  email    String? @unique // Optional for beneficiaries, required for officers
  phone    String? @unique // For login
  password String
  role     Role    @default(BENEFICIARY)

  // KYC Fields
  aadhaar      String? @unique
  casteCert    String?
  incomeCert   String?
  profileImage String?

  // Socio-Economic
  income     Int?
  age        Int?
  gender     String?
  education  EducationLevel?
  skill      SkillLevel?
  occupation String?         // Added for profile display

  // Address
  state    String?
  district String?
  block    String?
  pincode  String?

  // Bank Details
  bankAccount String?
  ifsc        String?

  // Verification
  verificationStatus  VerificationStatus @default(PENDING)
  verificationRemarks String?
  documents           String[] // Array of URLs

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- RELATIONS ---
  
  // 1. New Scheme Flow
  beneficiarySchemes BeneficiaryScheme[] @relation("EligibleBeneficiaries")
  schemesCreated     Scheme[]            @relation("PosterSchemes") // For POSTER role

  // 2. Verification Flow
  beneficiaryVerifications BeneficiaryVerification[] @relation("UserVerifications")
  enumeratorVerifications  BeneficiaryVerification[] @relation("Enumerator")
  
  // 3. Payment Flow (Your Existing)
  paymentResolutionProofs  PaymentResolutionProof[] @relation("ProofOwner")
  reviewedResolutionProofs PaymentResolutionProof[] @relation("ProofReviewer")

  // 4. Misc
  schemeFeeds   SchemeFeed[] // Keeping for backward compatibility if needed
  notifications Notification[]
}

//////////////////////////////////////
// SCHEME MODEL (Unified)
//////////////////////////////////////
model Scheme {
  id           String   @id @default(uuid())
  schemeId     String   @unique // Manual Code e.g. "SCH-EDU-001"
  title        String
  description  String?
  
  // Who created it?
  posterId     String?
  poster       User?    @relation("PosterSchemes", fields: [posterId], references: [id])
  
  // Lifecycle
  status       SchemeStatus   @default(PENDING) // PENDING -> APPROVED -> REJECTED
  
  // Classification
  schemeType   String   // "education", "housing", "employment", "financial"
  
  // Location Criteria
  state        String   // "Uttar Pradesh" or "All"
  district     String   // "Lucknow" or "All"
  pincode      String?  // "226021" or "All"

  // Eligibility Criteria (minIncome, educationLevel, etc.)
  baseCriteria Json 
  
  // Dynamic Form Fields (The "Additional Documents" config)
  // Stores: { textFields: [{id, label}], fileFields: [{id, label}] }
  extraFields  Json?    

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- RELATIONS ---
  beneficiaries     BeneficiaryScheme[]       @relation("EligibleSchemes")
  feeds             SchemeFeed[]              // Keeping for backward compatibility
  verifications     BeneficiaryVerification[]

  // Indexing for faster eligibility checks
  @@index([state, district])
}

//////////////////////////////////////
// BENEFICIARY SCHEME (New Application Flow)
//////////////////////////////////////
model BeneficiaryScheme {
  id              String            @id @default(uuid())
  beneficiaryId   String
  schemeId        String
  
  status          ApplicationStatus @default(ELIGIBLE)
  applicationData Json?             // Stores answers to extraFields
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  beneficiary     User   @relation("EligibleBeneficiaries", fields: [beneficiaryId], references: [id])
  scheme          Scheme @relation("EligibleSchemes", fields: [schemeId], references: [id])

  @@unique([beneficiaryId, schemeId]) // One app per scheme per user
  @@index([beneficiaryId])
  @@index([schemeId])
}

//////////////////////////////////////
// SCHEME FEED (Legacy / Alternate Flow)
//////////////////////////////////////
model SchemeFeed {
  id               String           @id @default(uuid())
  schemeId         String
  userId           String
  eligibilityScore Int?
  status           SchemeFeedStatus @default(NOTIFIED)
  appliedDocs      Json?
  createdAt        DateTime         @default(now())

  scheme Scheme @relation(fields: [schemeId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  paymentTransactions PaymentTransaction[]

  @@unique([userId, schemeId])
}

//////////////////////////////////////
// BENEFICIARY VERIFICATION
//////////////////////////////////////
model BeneficiaryVerification {
  id           String             @id @default(uuid())
  userId       String
  enumeratorId String?
  schemeId     String?
  status       VerificationStatus @default(UNDER_REVIEW)
  remarks      String?
  documents    Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user       User    @relation("UserVerifications", fields: [userId], references: [id])
  enumerator User?   @relation("Enumerator", fields: [enumeratorId], references: [id])
  scheme     Scheme? @relation(fields: [schemeId], references: [id])
}

//////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////
model Notification {
  id        String    @id @default(uuid())
  userId    String
  message   String
  read      Boolean   @default(false)
  status    JobStatus @default(PENDING) // For Queue Worker status
  channel   String    @default("SMS")   // SMS, WHATSAPP, EMAIL
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

//////////////////////////////////////
// CSV LOG (Reporting)
//////////////////////////////////////
model CsvLog {
  id        String   @id @default(cuid())
  schemeId  String?  // Optional link to a scheme report
  fileName  String?  // Generated filename
  status    String   // 'PENDING', 'PROCESSING', 'COMPLETED', 'FAILED'
  rowCount  Int?
  error     String?
  fileUrl   String?  // Cloudinary URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Just an alias for CsvReport if used in code
model CsvReport {
  id          String   @id @default(cuid())
  schemeId    String?
  generatedBy String?
  filters     Json?
  status      String   @default("PENDING")
  fileUrl     String?
  createdAt   DateTime @default(now())
}

//////////////////////////////////////
// PAYMENT ERROR CODE
//////////////////////////////////////
model PaymentErrorCode {
  id              String               @id @default(cuid())
  code            String               @unique // e.g. "CPE0025"
  title           String 
  technicalReason String 
  userMessage     String 
  resolutionSteps String 
  resolver        PaymentErrorResolver 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions PaymentTransaction[]
}

//////////////////////////////////////
// PAYMENT TRANSACTION
//////////////////////////////////////
model PaymentTransaction {
  id              String        @id @default(uuid())
  schemeFeedId    String
  errorCodeId     String?
  transactionRef  String?       @unique 
  amount          Int? 
  status          PaymentStatus @default(PENDING)
  rawErrorMessage String? 
  simulated       Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schemeFeed       SchemeFeed               @relation(fields: [schemeFeedId], references: [id])
  errorCode        PaymentErrorCode?        @relation(fields: [errorCodeId], references: [id])
  resolutionProofs PaymentResolutionProof[]

  @@index([schemeFeedId])
}

//////////////////////////////////////
// PAYMENT RESOLUTION PROOF
//////////////////////////////////////
model PaymentResolutionProof {
  id                   String           @id @default(uuid())
  paymentTransactionId String
  userId               String 
  description          String? 
  proofUrls            String[] 
  status               ResolutionStatus @default(SUBMITTED)

  reviewerId      String? 
  reviewerRemarks String? 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])
  user               User               @relation("ProofOwner", fields: [userId], references: [id])
  reviewer           User?              @relation("ProofReviewer", fields: [reviewerId], references: [id])

  @@index([paymentTransactionId])
  @@index([userId])
  @@index([reviewerId])
}

//////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  role      String
  action    String
  target    String
  timestamp DateTime @default(now())
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////
enum Role {
  BENEFICIARY
  ENUMERATOR
  OFFICER
  ADMIN
  POSTER
}

enum SchemeStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum EducationLevel {
  MATRICULATION
  HIGHER_SECONDARY
  GRADUATION
  POST_GRADUATION
  DIPLOMA
  PHD
}

enum SkillLevel {
  NONE
  BASIC_COMPUTER
  TENTH_PASS
  TWELFTH_PASS
  ITI
  POLYTECHNIC
  GRADUATE
}

enum SchemeFeedStatus {
  NOTIFIED
  APPLIED
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum PaymentErrorResolver {
  BENEFICIARY
  OFFICER
  BANK
  SYSTEM
}

enum ResolutionStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

// New Enum for application status (Your Workflow)
enum ApplicationStatus {
  ELIGIBLE    // Found by the system, can apply
  APPLIED     // User has submitted the application
  APPROVED    // Officer has approved the application
  REJECTED    // Officer has rejected the application
}