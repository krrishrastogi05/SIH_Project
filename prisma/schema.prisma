generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// USER MODEL
//////////////////////////////////////
model User {
  id       String  @id @default(uuid())
  scId     String  @unique // Beneficiary SC ID
  name     String
  email    String? @unique // Optional for beneficiaries
  phone    String? @unique // For login
  password String
  role     Role    @default(BENEFICIARY)

  // KYC Fields
  aadhaar      String? @unique
  casteCert    String?
  incomeCert   String?
  profileImage String?

  // Socio-Economic
  income    Int?
  age       Int?
  gender    String?
  education EducationLevel?
  skill     SkillLevel?

  // Address
  state    String?
  district String?
  block    String?
  pincode  String?

  // Bank Details
  bankAccount String?
  ifsc        String?

  // Verification
  verificationStatus  VerificationStatus @default(PENDING)
  verificationRemarks String?
  documents           String[] // Array of URLs

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  schemeFeeds              SchemeFeed[]
  beneficiaryVerifications BeneficiaryVerification[] @relation("UserVerifications")
  enumeratorVerifications  BeneficiaryVerification[] @relation("Enumerator")
  notifications            Notification[]
}

//////////////////////////////////////
// SCHEME MODEL
//////////////////////////////////////
model Scheme {
  id           String   @id @default(cuid())
  schemeId     String   @unique // e.g., SCH-EDU-001
  title        String
  schemeType   String // "education", "housing", "employment", "financial"
  baseCriteria Json // Store base criteria object
  extraFields  Json // Store extra fields config
  state        String
  district     String
  pincode      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  feeds         SchemeFeed[]
  verifications BeneficiaryVerification[]
}

//////////////////////////////////////
// SCHEME FEED
//////////////////////////////////////
model SchemeFeed {
  id               String           @id @default(uuid())
  schemeId         String
  userId           String
  eligibilityScore Int?
  status           SchemeFeedStatus @default(NOTIFIED)
  appliedDocs      Json?
  createdAt        DateTime         @default(now())

  scheme Scheme @relation(fields: [schemeId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, schemeId])
}

//////////////////////////////////////
// BENEFICIARY VERIFICATION
//////////////////////////////////////
model BeneficiaryVerification {
  id           String             @id @default(uuid())
  userId       String
  enumeratorId String?
  schemeId     String?
  status       VerificationStatus @default(UNDER_REVIEW)
  remarks      String?
  documents    Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user       User    @relation("UserVerifications", fields: [userId], references: [id])
  enumerator User?   @relation("Enumerator", fields: [enumeratorId], references: [id])
  scheme     Scheme? @relation(fields: [schemeId], references: [id])
}

//////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////
model Notification {
  id        String    @id @default(uuid())
  userId    String
  message   String
  read      Boolean   @default(false)
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

//////////////////////////////////////
// CSV LOG
//////////////////////////////////////
model CsvLog {
  id        String   @id @default(cuid())
  fileName  String
  status    String // e.g., 'PENDING', 'PROCESSING', 'COMPLETED', 'FAILED'
  rowCount  Int
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  role      String
  action    String
  target    String
  timestamp DateTime @default(now())
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////
enum Role {
  BENEFICIARY
  ENUMERATOR
  OFFICER
  ADMIN
}

enum SchemeStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum EducationLevel {
  MATRICULATION
  HIGHER_SECONDARY
  GRADUATION
  POST_GRADUATION
  DIPLOMA
  PHD
}

enum SkillLevel {
  NONE
  BASIC_COMPUTER
  TENTH_PASS
  TWELFTH_PASS
  ITI
  POLYTECHNIC
  GRADUATE
}

enum SchemeFeedStatus {
  NOTIFIED
  APPLIED
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
