generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String
  role      Role     @default(BENEFICIARY)

  // Newly added fields
  state     String?
  district  String?
  block     String?
  income    Int?
  age       Int?
  gender    String?

  documents String[] // <-- ADD THIS LINE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiaryVerifications BeneficiaryVerification[] @relation("UserVerifications")
  enumeratorVerifications  BeneficiaryVerification[] @relation("Enumerator")
  notifications            Notification[]
  schemeFeeds              SchemeFeed[]
}

model SchemePoster {
  id        String   @id @default(uuid())
  name      String
  type      String
  phone     String
  email     String?
  state     String?
  district  String?
  block     String?
  createdAt DateTime @default(now())

  schemes SchemePost[]
}

model SchemePost {
  id             String       @id @default(uuid())
  posterId       String
  title          String
  description    String
  incomeRequired Boolean      @default(false)
  minIncome      Int?
  maxIncome      Int?
  regionType     String?
  state          String?
  district       String?
  block          String?
  jobType        String?
  paymentInfo    Json?
  additionalDocs Json?
  status         SchemeStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  poster        SchemePoster              @relation(fields: [posterId], references: [id])
  feeds         SchemeFeed[]
  verifications BeneficiaryVerification[]
  csvLogs   CsvLog[]
}

model SchemeFeed {
  id               String     @id @default(uuid())
  schemeId         String
  userId           String
  eligibilityScore Int
  status           FeedStatus @default(NOTIFIED)

  scheme SchemePost @relation(fields: [schemeId], references: [id])
  user   User       @relation(fields: [userId], references: [id])
}

model BeneficiaryVerification {
  id           String              @id @default(cuid())
  status       VerificationStatus  @default(UNDER_REVIEW)
  feedback     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  userId       String
  enumeratorId String?
  remarks      String?
  documents    Json?
  user         User        @relation("UserVerifications", fields: [userId], references: [id])
  enumerator   User?       @relation("Enumerator", fields: [enumeratorId], references: [id])
  scheme       SchemePost? @relation(fields: [schemeId], references: [id])
  schemeId     String?
}


model Notification {
  id        String   @id @default(cuid())
  message   String
  read      Boolean  @default(false)
  status    JobStatus @default(PENDING) // <-- ADD THIS LINE
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

enum Role {
  BENEFICIARY
  ENUMERATOR
  OFFICER
  POSTER
  ADMIN
}

enum SchemeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedStatus {
  NOTIFIED
  INTERESTED
  APPLIED
}

enum VerificationStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CsvLog {
  id        String    @id @default(cuid())
  status    JobStatus @default(PENDING)
  filePath  String?   // URL to the generated CSV file in Cloudinary
  error     String?   // To store any error messages
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relation to the scheme the CSV is for
  schemeId  String
  scheme    SchemePost @relation(fields: [schemeId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  role      String
  action    String
  target    String
  timestamp DateTime @default(now())
}

