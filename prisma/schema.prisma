generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// USER MODEL
//////////////////////////////////////
model User {
  id       String @id @default(uuid())
  scId     String @unique  // Beneficiary SC ID
  name     String
  email    String? @unique  // Optional for beneficiaries
  phone    String? @unique  // For login
  password String
  role     Role    @default(BENEFICIARY)

  // KYC Fields
  aadhaar      String? @unique
  casteCert    String?
  incomeCert   String?
  profileImage String?

  // Socio-Economic
  income    Int?
  age       Int?
  gender    String?
  education EducationLevel?
  skill     SkillLevel?

  // Address
  state    String?
  district String?
  block    String?
  pincode  String?

  // Bank Details
  bankAccount String?
  ifsc        String?

  // Verification
  verificationStatus  VerificationStatus @default(PENDING)
  verificationRemarks String?
  documents           String[] // Array of URLs

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  schemeFeeds              SchemeFeed[]
  beneficiaryVerifications BeneficiaryVerification[] @relation("UserVerifications")
  enumeratorVerifications  BeneficiaryVerification[] @relation("Enumerator")
  notifications            Notification[]
}

//////////////////////////////////////
// SCHEME POSTER
//////////////////////////////////////
model SchemePoster {
  id        String   @id @default(uuid())
  name      String
  type      String   // GOV/NGO
  phone     String
  email     String?
  state     String?
  district  String?
  block     String?
  createdAt DateTime @default(now())

  schemes SchemePost[]
}

//////////////////////////////////////
// SCHEME POST
//////////////////////////////////////
model SchemePost {
  id             String       @id @default(uuid())
  posterId       String
  title          String
  description    String
  incomeRequired Boolean      @default(false)
  minIncome      Int?
  maxIncome      Int?
  minAge         Int?
  maxAge         Int?
  requiredEducation EducationLevel?
  requiredSkill  SkillLevel?
  regionType     String?
  state          String?
  district       String?
  block          String?
  jobType        String?
  paymentInfo    Json?
  additionalDocs Json?
  status         SchemeStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  poster        SchemePoster              @relation(fields: [posterId], references: [id])
  feeds         SchemeFeed[]
  verifications BeneficiaryVerification[]
  csvLogs       CsvLog[]
}

//////////////////////////////////////
// SCHEME FEED
//////////////////////////////////////
model SchemeFeed {
  id               String             @id @default(uuid())
  schemeId         String
  userId           String
  eligibilityScore Int?
  status           SchemeFeedStatus   @default(NOTIFIED)
  appliedDocs      Json?
  createdAt        DateTime           @default(now())

  scheme SchemePost @relation(fields: [schemeId], references: [id])
  user   User       @relation(fields: [userId], references: [id])

  @@unique([userId, schemeId])
}

//////////////////////////////////////
// BENEFICIARY VERIFICATION
//////////////////////////////////////
model BeneficiaryVerification {
  id           String             @id @default(uuid())
  userId       String
  enumeratorId String?
  schemeId     String?
  status       VerificationStatus @default(UNDER_REVIEW)
  remarks      String?
  documents    Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user       User        @relation("UserVerifications", fields: [userId], references: [id])
  enumerator User?       @relation("Enumerator", fields: [enumeratorId], references: [id])
  scheme     SchemePost? @relation(fields: [schemeId], references: [id])
}

//////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////
model Notification {
  id        String    @id @default(uuid())
  userId    String
  message   String
  read      Boolean   @default(false)
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

//////////////////////////////////////
// CSV LOG
//////////////////////////////////////
model CsvLog {
  id        String    @id @default(uuid())
  schemeId  String
  status    JobStatus @default(PENDING)
  filePath  String?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  scheme SchemePost @relation(fields: [schemeId], references: [id])
}

//////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  role      String
  action    String
  target    String
  timestamp DateTime @default(now())
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////
enum Role {
  BENEFICIARY
  ENUMERATOR
  OFFICER
  POSTER
  ADMIN
}

enum SchemeStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum EducationLevel {
  MATRICULATION
  HIGHER_SECONDARY
  GRADUATION
  POST_GRADUATION
  DIPLOMA
  PHD
}

enum SkillLevel {
  NONE
  BASIC_COMPUTER
  TENTH_PASS
  TWELFTH_PASS
  ITI
  POLYTECHNIC
  GRADUATE
}

enum SchemeFeedStatus {
  NOTIFIED
  APPLIED
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
