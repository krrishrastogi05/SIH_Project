// FILE: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// USER MODEL (UPDATED)
//////////////////////////////////////
model User {
  id        String   @id @default(uuid())

  scId      String   @unique          // Beneficiary login ID
  name      String
  email     String?  @unique          // Optional for beneficiaries
  phone     String?

  password  String?
  role      Role     @default(BENEFICIARY)

  //////////////////////////////////////
  // KYC FIELDS
  //////////////////////////////////////
  aadhaar       String? @unique
  casteCert     String?
  incomeCert    String?
  profileImage  String?

  //////////////////////////////////////
  // SOCIO-ECONOMIC FIELDS
  //////////////////////////////////////
  income        Int?
  age           Int?
  gender        String?
  education     EducationLevel?
  skill         SkillLevel?

  //////////////////////////////////////
  // ADDRESS
  //////////////////////////////////////
  state     String?
  district  String?
  block     String?

  //////////////////////////////////////
  // BANK DETAILS
  //////////////////////////////////////
  bankAccount  String?
  ifsc         String?

  //////////////////////////////////////
  // VERIFICATION WORKFLOW
  //////////////////////////////////////
  verificationStatus  VerificationStatus @default(PENDING)
  verificationRemarks String?
  documents           String[]           // Array of Cloudinary URLs

  //////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////
  schemeFeeds              SchemeFeed[]
  beneficiaryVerifications BeneficiaryVerification[] @relation("UserVerifications")
  enumeratorVerifications  BeneficiaryVerification[] @relation("Enumerator")
  notifications            Notification[]
}

//////////////////////////////////////
// OTHER MODELS (EXISTING - KEEP AS IS)
//////////////////////////////////////
model SchemePoster {
  id        String   @id @default(uuid())
  name      String
  type      String
  phone     String
  email     String?
  state     String?
  district  String?
  block     String?
  createdAt DateTime @default(now())
  
  schemes   SchemePost[]
}

model SchemePost {
  id              String        @id @default(uuid())
  posterId        String
  title           String
  description     String
  incomeRequired  Boolean       @default(false)
  minIncome       Int?
  maxIncome       Int?
  regionType      String?
  state           String?
  district        String?
  block           String?
  jobType         String?
  paymentInfo     Json?
  additionalDocs  Json?
  status          SchemeStatus  @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  poster          SchemePoster  @relation(fields: [posterId], references: [id])
  feeds           SchemeFeed[]
  verifications   BeneficiaryVerification[]
  csvLogs         CsvLog[]
}

model SchemeFeed {
  id               String      @id @default(uuid())
  schemeId         String
  userId           String
  eligibilityScore Int
  status           FeedStatus  @default(NOTIFIED)
  
  scheme           SchemePost  @relation(fields: [schemeId], references: [id])
  user             User        @relation(fields: [userId], references: [id])
}

model BeneficiaryVerification {
  id            String              @id @default(cuid())
  status        VerificationStatus  @default(UNDER_REVIEW)
  feedback      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  userId        String
  enumeratorId  String?
  remarks       String?
  documents     Json?
  schemeId      String?
  
  user          User                @relation("UserVerifications", fields: [userId], references: [id])
  enumerator    User?               @relation("Enumerator", fields: [enumeratorId], references: [id])
  scheme        SchemePost?         @relation(fields: [schemeId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  read      Boolean  @default(false)
  status    JobStatus @default(PENDING)
  createdAt DateTime @default(now())
  userId    String
  
  user      User     @relation(fields: [userId], references: [id])
}

model CsvLog {
  id        String    @id @default(cuid())
  status    JobStatus @default(PENDING)
  filePath  String?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  schemeId  String
  
  scheme    SchemePost @relation(fields: [schemeId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  role      String
  action    String
  target    String
  timestamp DateTime @default(now())
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////
enum Role {
  BENEFICIARY
  ENUMERATOR
  OFFICER
  POSTER
  ADMIN
}

enum SchemeStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum EducationLevel {
  NONE
  SCHOOL
  UG
  PG
  DIPLOMA
  PHD
}

enum SkillLevel {
  NONE
  BASIC_COMPUTER
  TENTH_PASS
  TWELFTH_PASS
  ITI
  POLYTECHNIC
  GRADUATE
}

enum SchemeFeedStatus {
  NOTIFIED
  APPLIED
  APPROVED
  REJECTED
  UNDER_REVIEW
}

///////////////////////////////////////////////////////
// USER (BENEFICIARY / ENUMERATOR / OFFICER / ADMIN)
///////////////////////////////////////////////////////

model User {
  id        String   @id @default(uuid())

  scId      String   @unique          // NEW
  name      String
  email     String   @unique
  phone     String?

  password  String?
  role      Role

  //////////////////////////////////////
  // KYC FIELDS (NEW)
  //////////////////////////////////////
  aadhaar       String? @unique
  casteCert     String?
  incomeCert    String?
  profileImage  String?

  //////////////////////////////////////
  // SOCIO-ECONOMIC FIELDS
  //////////////////////////////////////
  income        Int?
  age           Int?
  gender        String?
  education     EducationLevel?
  skill         SkillLevel?

  //////////////////////////////////////
  // ADDRESS
  //////////////////////////////////////
  state     String?
  district  String?
  block     String?

  //////////////////////////////////////
  // BANK DETAILS
  //////////////////////////////////////
  bankAccount  String?
  ifsc         String?

  //////////////////////////////////////
  // VERIFICATION WORKFLOW
  //////////////////////////////////////
  verificationStatus  VerificationStatus @default(PENDING)
  verificationRemarks String?
  documents           String[]           // existing

  //////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////
  schemeFeeds   SchemeFeed[]
  beneficiaryVerifications BeneficiaryVerification[]

  //////////////////////////////////////
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

///////////////////////////////////////////////////////
// SCHEME POSTER
///////////////////////////////////////////////////////

model SchemePoster {
  id        String   @id @default(uuid())
  name      String
  type      String   // GOV / NGO
  phone     String
  email     String?
  state     String?
  district  String?
  block     String?

  schemes   SchemePost[]
}

///////////////////////////////////////////////////////
// SCHEME POST
///////////////////////////////////////////////////////

model SchemePost {
  id        String   @id @default(uuid())

  posterId  String
  poster    SchemePoster @relation(fields: [posterId], references: [id])

  title       String
  description String

  //////////////////////////////////////
  // INCOME RULES (already existed)
  //////////////////////////////////////
  incomeRequired Boolean
  minIncome      Int?
  maxIncome      Int?

  //////////////////////////////////////
  // NEW ELIGIBILITY FIELDS
  //////////////////////////////////////
  minAge         Int?
  maxAge         Int?
  requiredEducation EducationLevel?
  requiredSkill  SkillLevel?

  additionalDocs Json?  // poster-defined

  jobType     String
  paymentInfo Json?

  regionType  String
  state       String
  district    String
  block       String

  status      SchemeStatus @default(PENDING)

  schemeFeeds SchemeFeed[]
  beneficiaryVerifications BeneficiaryVerification?[]

  createdAt DateTime @default(now())
}

///////////////////////////////////////////////////////
// SCHEME FEED (Eligibility + Apply + Notifications)
///////////////////////////////////////////////////////

model SchemeFeed {
  id        String   @id @default(uuid())

  userId    String
  schemeId  String

  user      User       @relation(fields: [userId], references: [id])
  scheme    SchemePost @relation(fields: [schemeId], references: [id])

  eligibilityScore Int?
  status      SchemeFeedStatus @default(NOTIFIED)

  appliedDocs Json?  // NEW: documents user uploaded during apply

  createdAt DateTime @default(now())

  @@unique([userId, schemeId])
}

///////////////////////////////////////////////////////
// BENEFICIARY VERIFICATION (Enumerator / Aadhaar)
///////////////////////////////////////////////////////

model BeneficiaryVerification {
  id          String   @id @default(uuid())

  userId      String
  user        User      @relation(fields: [userId], references: [id])

  schemeId    String?
  SchemePost  SchemePost? @relation(fields: [schemeId], references: [id])

  enumeratorId String?
  enumerator   User?     @relation("EnumeratorVerification", fields: [enumeratorId], references: [id])

  status      VerificationStatus
  remarks     String?
  documents   Json?
  createdAt   DateTime @default(now())
}

///////////////////////////////////////////////////////
// AUDIT LOG
///////////////////////////////////////////////////////

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  role      String
  action    String
  target    String
  timestamp DateTime @default(now())
}

///////////////////////////////////////////////////////
// CSV REPORTS
///////////////////////////////////////////////////////

model CsvReport {
  id          String   @id @default(uuid())
  schemeId    String?
  generatedBy String?
  filters     Json
  status      String
  fileUrl     String?
  createdAt   DateTime @default(now())
}

model CsvLog {
  id        String @id @default(uuid())
  schemeId  String
  createdAt DateTime @default(now())
}
